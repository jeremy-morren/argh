<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs Nullean.Argh.Tests.Netstandard on each runtime. Normal asset selection picks the fixture and Argh library builds:
    net472 gets netstandard2.0 of both; netcoreapp3.1, net5.0 and net6.0 get the netstandard2.1 fixture and the
    netstandard2.0 libraries; net8.0 and net10.0 get their own.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net472;netcoreapp3.1;net5.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The .NET hosts run through `dotnet exec`, so they don't need a native launcher. -->
    <UseAppHost Condition="'$(TargetFramework)' != 'net472'">false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Nullean.Argh.Tests.NetstandardHost\Program.cs" Link="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nullean.Argh.Tests.Netstandard\Nullean.Argh.Tests.Netstandard.csproj" />
  </ItemGroup>

</Project>
