<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nullean.Argh.IntegrationTests</AssemblyName>
    <RootNamespace>Nullean.Argh.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nullean.Argh.Tests.CliHost\Nullean.Argh.Tests.CliHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Nullean.Argh.Tests.NetstandardHost\Nullean.Argh.Tests.NetstandardHost.csproj" ReferenceOutputAssembly="false" />
    <!-- Builds every target framework of the multi-targeted host (the outer build), not just the nearest one. -->
    <ProjectReference Include="..\Nullean.Argh.Tests.FrameworkHost\Nullean.Argh.Tests.FrameworkHost.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\Nullean.Argh.Tests.NetstandardHost.NullableDisabled\Nullean.Argh.Tests.NetstandardHost.NullableDisabled.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Nullean.Argh.Tests.FrameworkHost.NullableDisabled\Nullean.Argh.Tests.FrameworkHost.NullableDisabled.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!--
    The hosts load an assembly named Nullean.Argh.Tests.Netstandard built for different frameworks and nullable
    settings, so each host is copied into its own folder instead of next to the tests: netstandard-host/ and
    fw/<config>_<tfm>/, plus netstandard-host-nullable-disabled/ and fw-nullable-disabled/<config>_<tfm>/.
    The names stay short because the net472 host can't start from a path longer than MAX_PATH (260).
  -->
  <Target Name="CopyFrameworkHostsToIntegrationTestOutput" AfterTargets="Build">
    <PropertyGroup>
      <_NsHostCfg>$([System.String]::Copy('$(Configuration)').ToLowerInvariant())</_NsHostCfg>
      <_NsHostDir>$([System.IO.Path]::Combine('$(ArtifactsPath)', 'bin', 'Nullean.Argh.Tests.NetstandardHost', '$(_NsHostCfg)'))\</_NsHostDir>
      <_FwHostDir>$([System.IO.Path]::Combine('$(ArtifactsPath)', 'bin', 'Nullean.Argh.Tests.FrameworkHost'))\</_FwHostDir>
      <_NsNdHostDir>$([System.IO.Path]::Combine('$(ArtifactsPath)', 'bin', 'Nullean.Argh.Tests.NetstandardHost.NullableDisabled', '$(_NsHostCfg)'))\</_NsNdHostDir>
      <_FwNdHostDir>$([System.IO.Path]::Combine('$(ArtifactsPath)', 'bin', 'Nullean.Argh.Tests.FrameworkHost.NullableDisabled'))\</_FwNdHostDir>
    </PropertyGroup>
    <ItemGroup>
      <_NsHostFiles Include="$(_NsHostDir)*.*" Exclude="$(_NsHostDir)*.pdb" />
      <_FwHostAll Include="$(_FwHostDir)**\*.*" Exclude="$(_FwHostDir)**\*.pdb" />
      <_FwHostFiles Include="@(_FwHostAll)" Condition="$([System.String]::Copy('%(RecursiveDir)').StartsWith('$(_NsHostCfg)_'))" />
      <_NsNdHostFiles Include="$(_NsNdHostDir)*.*" Exclude="$(_NsNdHostDir)*.pdb" />
      <_FwNdHostAll Include="$(_FwNdHostDir)**\*.*" Exclude="$(_FwNdHostDir)**\*.pdb" />
      <_FwNdHostFiles Include="@(_FwNdHostAll)" Condition="$([System.String]::Copy('%(RecursiveDir)').StartsWith('$(_NsHostCfg)_'))" />
    </ItemGroup>
    <Copy SourceFiles="@(_NsHostFiles)" DestinationFolder="$(OutputPath)netstandard-host" SkipUnchangedFiles="true" Condition="'@(_NsHostFiles)' != ''" />
    <Copy SourceFiles="@(_FwHostFiles)" DestinationFolder="$(OutputPath)fw\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_FwHostFiles)' != ''" />
    <Copy SourceFiles="@(_NsNdHostFiles)" DestinationFolder="$(OutputPath)netstandard-host-nullable-disabled" SkipUnchangedFiles="true" Condition="'@(_NsNdHostFiles)' != ''" />
    <Copy SourceFiles="@(_FwNdHostFiles)" DestinationFolder="$(OutputPath)fw-nullable-disabled\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_FwNdHostFiles)' != ''" />
  </Target>

  <Target Name="CopyCliHostToIntegrationTestOutput" AfterTargets="Build">
    <PropertyGroup>
      <_CliHostCfg>$([System.String]::Copy('$(Configuration)').ToLowerInvariant())</_CliHostCfg>
      <_CliHostDir>$([System.IO.Path]::Combine('$(ArtifactsPath)', 'bin', 'Nullean.Argh.Tests.CliHost', '$(_CliHostCfg)'))\</_CliHostDir>
    </PropertyGroup>
    <ItemGroup>
      <_CliHostFiles Include="$(_CliHostDir)*.*" Exclude="$(_CliHostDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_CliHostFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_CliHostFiles)' != ''" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Proc" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="GitHubActionsTestLogger">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Nullean.VsTest.Pretty.TestLogger" PrivateAssets="All" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

</Project>
