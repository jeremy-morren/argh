<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nullean.Argh.Generator.Tests</AssemblyName>
    <RootNamespace>Nullean.Argh.Generator.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\build\keys\keypair.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nullean.Argh.Generator\Nullean.Argh.Generator.csproj" />
    <ProjectReference Include="..\..\src\Nullean.Argh.Interfaces\Nullean.Argh.Interfaces.csproj" />
    <!-- Lets the tests compile the generated code against the runtime it calls into. -->
    <ProjectReference Include="..\..\src\Nullean.Argh.Core\Nullean.Argh.Core.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="GitHubActionsTestLogger">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Nullean.VsTest.Pretty.TestLogger" PrivateAssets="All" />
  </ItemGroup>

  <!-- netstandard2.0 reference assembly for the polyfill tests, which compile code the way a netstandard2.0 project does. -->
  <ItemGroup>
    <PackageReference Include="NETStandard.Library" VersionOverride="2.0.3" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <None Include="$(PkgNETStandard_Library)\build\netstandard2.0\ref\netstandard.dll"
          Link="refs\netstandard2.0\netstandard.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
