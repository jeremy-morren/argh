<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the netstandard2.0 builds of Nullean.Argh.Tests.Netstandard and of the Argh libraries, so both the generated
    code and the libraries take their netstandard2.0 branches. Transitive references are off because they would bring
    in the net10.0 build of the libraries instead.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nullean.Argh.Tests.Netstandard\Nullean.Argh.Tests.Netstandard.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
    <!-- Single-target (netstandard2.0): SetTargetFramework here would start a second, clashing build of it. -->
    <ProjectReference Include="..\..\src\Nullean.Argh\Nullean.Argh.csproj" />
    <ProjectReference Include="..\..\src\Nullean.Argh.Core\Nullean.Argh.Core.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
    <ProjectReference Include="..\..\src\Nullean.Argh.Interfaces\Nullean.Argh.Interfaces.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
