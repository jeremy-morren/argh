<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hosted (Microsoft.Extensions.Hosting) variant for the bugs that need DI: bug22, bug25.

      dotnet build bugs/hosted -c Release
      .artifacts/bin/Bugs.Hosted/release/Bugs.Hosted.exe bug22
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Bugs.Hosted</AssemblyName>
    <RootNamespace>Bugs.Hosted</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nullean.Argh\Nullean.Argh.csproj" />
    <ProjectReference Include="..\..\src\Nullean.Argh.Hosting\Nullean.Argh.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Nullean.Argh.Generator\Nullean.Argh.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
