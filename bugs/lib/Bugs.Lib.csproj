<Project Sdk="Microsoft.NET.Sdk">

  <!-- Types that must live in a different assembly from the handlers: bug16, bug56, bug57. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Bugs.Lib</AssemblyName>
    <RootNamespace>Bugs.Lib</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nullean.Argh\Nullean.Argh.csproj" />
  </ItemGroup>

</Project>
